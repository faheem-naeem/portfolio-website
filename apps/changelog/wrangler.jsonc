{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "faheemnaeem-changelog",
    "compatibility_date": "2026-10-01",
    // Static Astro build served as Worker static assets (no Worker script).
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "routes": [
        { "pattern": "changelog.faheemnaeem.dev", "custom_domain": true }
    ],
    "observability": { "enabled": true }
}
