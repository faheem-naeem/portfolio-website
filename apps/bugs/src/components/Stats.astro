---
import { SEVERITIES, getStats, type Exhibit } from '../lib/exhibits';

interface Props {
    exhibits: Exhibit[];
}

const stats = getStats(Astro.props.exhibits);
---

<dl class="stats">
    <div class="stats__item">
        <dt>Bugs captured</dt>
        <dd class="stats__value">{stats.captured}</dd>
    </div>
    <div class="stats__item">
        <dt>Habitats</dt>
        <dd class="stats__value">{stats.habitats}</dd>
    </div>
    <div class="stats__item stats__item--wide">
        <dt>By danger level</dt>
        <dd>
            <ul class="stats__breakdown" role="list">
                {
                    SEVERITIES.map((s) => (
                        <li>
                            <span class={`badge badge--${s}`}>{s}</span>{' '}
                            {stats.bySeverity[s]}
                        </li>
                    ))
                }
            </ul>
        </dd>
    </div>
</dl>
