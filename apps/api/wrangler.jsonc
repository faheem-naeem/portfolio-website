{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "faheemnaeem-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "routes": [{ "pattern": "api.faheemnaeem.dev", "custom_domain": true }],
    "observability": { "enabled": true },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "faheemnaeem-api",
            "database_id": "d4522378-2e7d-4851-8dcd-bf3bc847e26b",
            "migrations_dir": "migrations",
        },
    ],
    // Email notifications are off: Email Routing is not set up on this domain.
    // Interview requests are still stored in D1. See README "Email
    // notifications" to re-enable the `send_email` binding later.
    "vars": {
        // Public Turnstile site key for the /contact form (not a secret).
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGF8dZt1jqFYAKMT",
    },
    // Secrets (not in this file): TURNSTILE_SECRET, IP_HASH_SALT, CTF_FLAG.
    // Set with `wrangler secret put <NAME>`; locally use .dev.vars.
}
