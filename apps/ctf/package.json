{
    "name": "ctf",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "build": "wrangler deploy --dry-run --outdir dist",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "make-flag": "node scripts/make-flag.mjs",
        "db:migrate:local": "wrangler d1 migrations apply faheemnaeem-ctf --local"
    },
    "dependencies": {
        "@faheem/data": "workspace:*",
        "@faheem/ui": "workspace:*",
        "hono": "4.13.16"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261117.1",
        "@faheem/config": "workspace:*",
        "@types/node": "^22.18.0",
        "eslint": "^9.29.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4",
        "wrangler": "^4.156.2"
    }
}
