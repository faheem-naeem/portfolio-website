{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "faheemnaeem-status",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "routes": [{ "pattern": "status.faheemnaeem.dev", "custom_domain": true }],
    // ONE cron for the whole app (the account only has 5). Every run does the
    // health checks; the 03:00 UTC run also deletes rows older than 90 days.
    "triggers": { "crons": ["*/10 * * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "faheemnaeem-status",
            "database_id": "a95dd6f0-557f-4c14-8cc1-9cf95391124f",
            "migrations_dir": "migrations"
        }
    ],
    "observability": { "enabled": true }
}
