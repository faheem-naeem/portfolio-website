{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "faheemnaeem-ask",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "routes": [{ "pattern": "ask.faheemnaeem.dev", "custom_domain": true }],
    // Workers AI binding: free allowance of 10,000 Neurons/day on the Free
    // plan. No API key. Past the allowance calls fail (and are not billed);
    // the Worker then returns a friendly fallback message.
    "ai": { "binding": "AI" },
    "vars": {
        // Small, non-deprecated instruct model that needs no paid billing
        // method. See README "Model choice".
        "AI_MODEL": "@cf/ibm-granite/granite-4.0-h-micro",
        // Global questions per UTC day (keeps usage far below 10k Neurons).
        "DAILY_CAP": "150",
        // Public Turnstile site key (not a secret). Replace before deploying.
        "TURNSTILE_SITE_KEY": "<TURNSTILE_SITE_KEY>",
        // Set to "development" in .dev.vars to allow the local Turnstile bypass.
        "ENVIRONMENT": "production"
    },
    // Counters (per-IP hourly, global daily) and the question log live in D1:
    // KV's free plan only allows 1,000 writes/day.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "faheemnaeem-ask",
            // TODO: replace after `wrangler d1 create faheemnaeem-ask`
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    "observability": { "enabled": true }
}
