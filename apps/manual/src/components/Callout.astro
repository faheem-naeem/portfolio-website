---
// Note / Tip / Warning callout. Markup matches calloutHtml() in lib/markdown.ts,
// which renders the same callouts from markdown (`> [!TIP]`). role="note" is not a
// landmark, so repeated callouts do not trip axe landmark-unique.
import { CALLOUT_LABELS, type CalloutType } from '../lib/markdown';

interface Props {
    type?: CalloutType;
}
const { type = 'note' } = Astro.props;
const label = CALLOUT_LABELS[type];
---

<div class={`callout callout--${type}`} role="note" aria-label={label}>
    <p class="callout__title">{label}</p>
    <slot />
</div>
