// Static Astro site served by Workers static assets (no Worker script).
// Build first (`pnpm --filter manual build`), then `wrangler deploy`.
{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "faheemnaeem-manual",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
    },
    "routes": [{ "pattern": "manual.faheemnaeem.dev", "custom_domain": true }],
    "observability": { "enabled": true }
}
